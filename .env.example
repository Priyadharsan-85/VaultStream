# VaultStream Environment Variables Example
# Copy this file to .env and fill in actual values

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vaultstream
SPRING_DATASOURCE_USERNAME=vaultstream_user
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Security
JWT_SECRET=your-super-secret-key-change-this-in-production-at-least-32-chars-long
JWT_EXPIRATION_MS=3600000

# Mail Configuration (if using email notifications)
SPRING_MAIL_HOST=smtp.example.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_username
SPRING_MAIL_PASSWORD=your_email_password

# Server Configuration
SERVER_PORT=8081

# Logging Path (optional)
LOG_PATH=./logs/vaultstream.log